---
import "@/styles/global.css"
import { IntakeForm } from "@/components/IntakeForm"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Innovation Lab Capital — Begin a conversation</title>
  </head>
  <body>
    <main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-10 px-6 py-16">
      <header class="space-y-3">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Innovation Lab Capital
        </p>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Private investment for accredited investors.
        </h1>
        <p class="max-w-prose text-base leading-relaxed text-muted-foreground">
          A small, selective practice. We invest patient capital alongside founders and operators
          we know well.
        </p>
      </header>
      <IntakeForm client:load />
    </main>
  </body>
</html>
