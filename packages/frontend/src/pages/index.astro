---
import "@/styles/global.css"
import { Button } from "@/components/ui/button"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>effect-redacted</title>
  </head>
  <body>
    <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-6 px-6">
      <header class="space-y-2">
        <h1 class="text-4xl font-semibold tracking-tight">effect-redacted</h1>
        <p class="text-muted-foreground">
          A sandbox for exploring Effect's <code class="rounded bg-muted px-1.5 py-0.5 text-sm">Schema.Redacted</code> across HttpApi, RPC, and Cluster boundaries.
        </p>
      </header>
      <div class="flex gap-3">
        <Button client:load>Get started</Button>
        <Button variant="outline" client:load>Docs</Button>
      </div>
    </main>
  </body>
</html>
