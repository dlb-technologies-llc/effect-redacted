{
  "name": "@effect-redacted/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@effect-redacted/shared": "workspace:*",
    "@effect/opentelemetry": "^4.0.0-beta.69",
    "@effect/platform-bun": "^4.0.0-beta.69",
    "@effect/platform-node": "^4.0.0-beta.69",
    "@effect/sql-pg": "^4.0.0-beta.69",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.203.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.203.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.33.0",
    "effect": "^4.0.0-beta.69"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0-beta.69",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
